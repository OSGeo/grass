{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":semanticCommits",
        ":semanticCommitTypeAll(CI)",

        // allows using comments starting with
        // "# renovate: " to update _VERSION
        // environment variables in GitHub Action files.
        "customManagers:githubActionsVersions",
        // allows using comments starting with
        // "# renovate: " to update _VERSION
        // ENV or ARG in a Dockerfile.
        "customManagers:dockerfileVersions",

        // when a dependency is really out of date, this will prevent to skip directly to the latest version.
        ":separateMultipleMajorReleases",

        // Renovate's pre-commit support is still opt-in
        ":enablePreCommit",

        // monthly update of lock files (flake.lock)
        ":maintainLockFilesMonthly",
        "group:githubArtifactActions",
    ],

    "baseBranchPatterns" : [
      "$default",
      "releasebranch_8_4",
      "releasebranch_8_5",
    ],

    // enable Nix lock file update (flake.lock)
    "nix": {
        "enabled": true,
    },

    // Default window for everything not scheduled by a rule below. Times are
    // in UTC so that the days below do not depend on the Renovate runner.
    "timezone": "UTC",
    "schedule": ["* * 1 * *"],

    // Do not create or update branches outside of the schedule. Each push to a
    // Renovate branch restarts CI.
    "updateNotScheduled": false,
    // Rebase only when there are conflicts, not each time the base branch moves.
    "rebaseWhen": "conflicted",

    // Cap the open PRs so that unmerged PRs hold back new ones instead of
    // piling up.
    "prConcurrentLimit": 10,
    "prHourlyLimit": 4,

    // Supply chain cooldown: only offer releases at least 7 days old. With
    // "strict", no branch is created until a release passes the check.
    "minimumReleaseAge": "7 days",
    "internalChecksFilter": "strict",

    "labels": ["dependencies"],
    "suppressNotifications": ["prIgnoreNotification", "prEditedNotification"],

    // The preset above only allows the first hours of the day.
    "lockFileMaintenance": {
        "schedule": ["* * 1 * *"],
    },

    // Security updates are not held back by the schedule or the cooldown.
    // Renovate finds them with its own vulnerability database (only PyPI) and
    // with the alerts of GitHub, which follow the default branch.
    "vulnerabilityAlerts": {
        // Explicit, so that the rule disabling the release branches below
        // does not apply to them.
        "enabled": true,
        "schedule": ["at any time"],
        "minimumReleaseAge": null,
        "labels": ["dependencies", "security"],
    },
    "osvVulnerabilityAlerts": true,

    "packageRules": [
        // Major updates, and Python minor versions, are only proposed once a
        // maintainer approves them on the Dependency Dashboard.
        {
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true,
        },
        {
            "matchDatasources": ["python-version"],
            "matchUpdateTypes": ["minor"],
            "dependencyDashboardApproval": true,
        },

        // Docker digests often have no release timestamp, so the cooldown
        // would hold them back indefinitely.
        {
            "matchDatasources": ["docker"],
            "matchUpdateTypes": ["digest", "pinDigest"],
            "minimumReleaseAge": null,
        },

        // Groups on the default branch, on different days so that their CI
        // runs do not queue together.
        {
            "groupName": "CI actions",
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
            "schedule": ["* * 1 * *"],
        },
        {
            "groupName": "linters and pre-commit hooks",
            "matchManagers": ["pre-commit"],
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "schedule": ["* * 8 * *"],
        },
        {
            // Versions set in "# renovate:" commented environment variables of
            // the workflows (ruff, flake8, pylint, bandit, prek). The Python
            // version is excluded, as its minor updates wait for approval.
            "groupName": "linters and pre-commit hooks",
            "matchManagers": ["custom.regex"],
            "matchFileNames": [".github/workflows/**"],
            "matchDatasources": ["!python-version"],
            "matchUpdateTypes": ["minor", "patch"],
            "schedule": ["* * 8 * *"],
        },
        {
            // Keep the major updates of the tools that are set both in
            // .pre-commit-config.yaml and in the workflows in one PR, so that
            // the two never end up on different majors.
            "groupName": "ruff",
            "matchUpdateTypes": ["major"],
            "schedule": ["* * 8 * *"],
            "matchPackageNames": [
                "astral-sh/ruff",
                "astral-sh/ruff-pre-commit",
                "ruff",
            ],
        },
        {
            "groupName": "flake8",
            "matchUpdateTypes": ["major"],
            "schedule": ["* * 8 * *"],
            "matchPackageNames": ["pycqa/flake8", "flake8"],
        },
        {
            "groupName": "black",
            "matchUpdateTypes": ["major"],
            "schedule": ["* * 8 * *"],
            "matchPackageNames": [
                "psf/black-pre-commit-mirror",
                "psf/black",
                "black",
            ],
        },
        {
            "groupName": "Python docs and tooling requirements",
            "matchManagers": ["pip_requirements", "pep621"],
            "matchUpdateTypes": ["minor", "patch"],
            "schedule": ["* * 10 * *"],
        },

        // The base image digests and the library versions built on top of
        // them (GEOS, PROJ, GDAL, PDAL, gdal-grass, wxPython) are one PR, so
        // that the Docker workflow tests them together. Base images are
        // rebuilt about every two weeks, so this runs twice a month, just
        // after the rebuilds of the Ubuntu images.
        {
            "groupName": "Docker base images and libraries",
            "matchManagers": ["dockerfile", "custom.regex"],
            "matchFileNames": ["Dockerfile", "docker/**"],
            "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
            "schedule": ["* * 3,17 * *"],
        },

        // Release branches only get security updates (see
        // "vulnerabilityAlerts") and one maintenance PR a month, without major
        // updates. During the stabilization of a release, set
        // "dependencyDashboardApproval" on the maintenance rules below.
        // Keep these rules last: later rules take precedence.
        {
            // The update types are listed because Renovate applies the rules
            // before it knows the update type of a dependency, and a rule
            // without them would disable the dependencies for good.
            "matchBaseBranches": ["/^releasebranch_/"],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "pin",
                "pinDigest",
                "digest",
                "lockFileMaintenance",
                "rollback",
                "bump",
                "replacement",
            ],
            "enabled": false,
        },
        {
            "groupName": "release branch maintenance",
            "matchBaseBranches": ["/^releasebranch_/"],
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "enabled": true,
            "schedule": ["* * 22 * *"],
        },
        {
            "groupName": "release branch maintenance",
            "matchBaseBranches": ["/^releasebranch_/"],
            "matchManagers": ["dockerfile", "custom.regex"],
            "matchFileNames": ["Dockerfile", "docker/**"],
            "matchUpdateTypes": ["patch", "digest"],
            "enabled": true,
            "schedule": ["* * 22 * *"],
        },
    ],
}
